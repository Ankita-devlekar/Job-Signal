# Screenshot originals are intentionally not part of this preparation copy.
# Add an individual negation only after manual approval, for example:
# !/screenshots/approved-example.png
/screenshots/**
!/screenshots/
!/screenshots/*.png
!/screenshots/*.jpg
!/screenshots/*.jpeg
!/screenshots/*.webp

# Retain only inference-time preprocessing artifacts
/data/processed/*
!/data/processed/binary_features.pkl
!/data/processed/categorical_features.pkl
!/data/processed/categorical_pipeline.pkl
!/data/processed/numerical_features.pkl
!/data/processed/numerical_pipeline.pkl
!/data/processed/text_features.pkl
!/data/processed/tfidf_vectorizer.pkl
!/data/processed/X_test_cleaned.pkl
!/data/processed/X_test_final.pkl

# Retain only application model artifacts
/models/*
!/models/best_model.pkl
!/models/engineered_features.pkl
!/models/engineered_imputer.pkl

# Retain only the model-comparison file read by the application
/results/*
!/results/model_results/
/results/model_results/*
!/results/model_results/model_comparison.csv

